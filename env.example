# Copy to .env, then: chmod 600 .env
API_DOMAIN=divine-ollama.duckdns.org
ADMIN_DOMAIN=divine-admin.duckdns.org
ACME_EMAIL=you@example.com

# Supabase (Project Settings -> API). The anon/publishable key is public by design.
# NEVER put the service_role key or your database password anywhere in this stack.
SUPABASE_URL=https://pqtcwnyeowcycvkmmjow.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Origin of your front page: scheme + host only, no path, no trailing slash
ALLOWED_ORIGINS=https://digaro24-ux.github.io
ALLOWED_MODELS=llama3.2:3b,qwen2.5:3b,qwen2.5-coder:3b
RATE_PER_MIN=20

# Admin console database. Generate: openssl rand -hex 24
POSTGRES_USER=divine
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=divine_admin
# Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGE_ME
ENABLE_SIGNUP=true   # set false right after you create the admin account
