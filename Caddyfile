{
	email {$ACME_EMAIL}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Public API used by the chat page
{$API_DOMAIN} {
	import headers
	encode zstd gzip
	reverse_proxy gateway:8000 {
		flush_interval -1
	}
}

# Admin console (model downloads, API keys). Optional: restrict to your IP:
#   @blocked not remote_ip YOUR.HOME.IP.ADDR
#   respond @blocked 403
{$ADMIN_DOMAIN} {
	import headers
	encode zstd gzip
	reverse_proxy open-webui:8080 {
		flush_interval -1
	}
}
